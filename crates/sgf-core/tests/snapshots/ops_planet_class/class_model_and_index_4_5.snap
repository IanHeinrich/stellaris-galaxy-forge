inverse: SetPlanetClass { planet: 1415, from: PlanetClassRule { class: "pc_barren", change: Uncolonised, models: 3 }, to: PlanetClassRule { class: "pc_gas_giant", change: Uncolonised, models: 5 }, look: Some(PlanetLook { entity: Some(3), entity_name: Some("gas_giant_02_entity") }) }

